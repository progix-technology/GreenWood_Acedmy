{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://greenwood-acedmy.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
